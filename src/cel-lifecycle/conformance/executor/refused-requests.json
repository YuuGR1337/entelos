{
 "format": "executor-vector/v1",
 "id": "refused-requests",
 "description": "The executor refuses a bad cursor, a date that is not a canonical ISO date, and inputs that are not a strict JSON object of string, boolean and null values. A refusal gives no entry. The Host records a receipt for a number value; the executor is narrower and refuses it.",
 "bundle": {
  "function_id": "record.visible",
  "profile": "cel-string-bool/v1",
  "caller_variables": [
   "state",
   "archived"
  ],
  "limits": {
   "max_request_bytes": 4096,
   "max_string_utf8_bytes": 256,
   "max_source_utf8_bytes": 4096,
   "parser_recursion_limit": 64,
   "evaluation_cost_limit": 1000
  },
  "environment": {
   "name": "record-filter",
   "variables": [
    {
     "name": "state",
     "type": "string",
     "description": "The record state supplied by the caller."
    },
    {
     "name": "archived",
     "type": "bool",
     "description": "Whether the caller record is archived."
    },
    {
     "name": "allowed_state",
     "type": "string",
     "description": "The fixed allowed state."
    }
   ]
  },
  "source": "state == allowed_state && !archived\n",
  "fixed": {
   "allowed_state": "ready"
  }
 },
 "pin": {
  "function": "record.visible",
  "scope": "tenant-example",
  "snapshot_ref": "sha256:5555555555555555555555555555555555555555555555555555555555555555",
  "from": "2026-11-01",
  "until": "2026-12-01",
  "stale_mode": "fail_closed",
  "revoked": false
 },
 "steps": [
  {
   "name": "cursor-zero",
   "cursor": 0,
   "date": "2026-11-15",
   "inputs_json": "{\"state\": \"ready\", \"archived\": false}",
   "expect": {
    "diagnostic": {
     "code": "invalid_request",
     "stage": "log",
     "field": "/cursor"
    }
   }
  },
  {
   "name": "cursor-over-2^53-1",
   "cursor": 9007199254740992,
   "date": "2026-11-15",
   "inputs_json": "{\"state\": \"ready\", \"archived\": false}",
   "expect": {
    "diagnostic": {
     "code": "invalid_request",
     "stage": "log",
     "field": "/cursor"
    }
   }
  },
  {
   "name": "short-date",
   "cursor": 1,
   "date": "2026-11-5",
   "inputs_json": "{\"state\": \"ready\", \"archived\": false}",
   "expect": {
    "diagnostic": {
     "code": "invalid_interval",
     "stage": "request",
     "field": "/date"
    }
   }
  },
  {
   "name": "date-time",
   "cursor": 1,
   "date": "2026-11-15T00:00:00Z",
   "inputs_json": "{\"state\": \"ready\", \"archived\": false}",
   "expect": {
    "diagnostic": {
     "code": "invalid_interval",
     "stage": "request",
     "field": "/date"
    }
   }
  },
  {
   "name": "array",
   "cursor": 1,
   "date": "2026-11-15",
   "inputs_json": "[]",
   "expect": {
    "diagnostic": {
     "code": "invalid_input",
     "stage": "input",
     "field": "/inputs"
    }
   }
  },
  {
   "name": "null",
   "cursor": 1,
   "date": "2026-11-15",
   "inputs_json": "null",
   "expect": {
    "diagnostic": {
     "code": "invalid_input",
     "stage": "input",
     "field": "/inputs"
    }
   }
  },
  {
   "name": "duplicate-key",
   "cursor": 1,
   "date": "2026-11-15",
   "inputs_json": "{\"state\":\"ready\",\"state\":\"closed\",\"archived\":false}",
   "expect": {
    "diagnostic": {
     "code": "invalid_input",
     "stage": "input",
     "field": "/inputs"
    }
   }
  },
  {
   "name": "lone-surrogate",
   "cursor": 1,
