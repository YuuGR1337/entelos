     "field": "/inputs"
    }
   }
  },
  {
   "name": "number-value",
   "cursor": 1,
   "date": "2026-11-15",
   "inputs_json": "{\"state\":1,\"archived\":false}",
   "expect": {
    "diagnostic": {
     "code": "invalid_input",
     "stage": "input",
     "field": "/inputs"
    }
   }
  },
  {
   "name": "nested-value",
   "cursor": 1,
   "date": "2026-11-15",
   "inputs_json": "{\"state\":{\"a\":\"b\"},\"archived\":false}",
   "expect": {
    "diagnostic": {
     "code": "invalid_input",
     "stage": "input",
     "field": "/inputs"
    }
   }
  },
  {
   "name": "two-values",
   "cursor": 1,
   "date": "2026-11-15",
   "inputs_json": "{} {}",
   "expect": {
    "diagnostic": {
     "code": "invalid_input",
