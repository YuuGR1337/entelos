     "field": "/inputs"
    }
   }
  },
  {
   "name": "over-limit",
   "cursor": 1,
   "date": "2026-11-15",
   "inputs_json": "{\"state\": \"\", \"archived\": false}",
   "expect": {
    "diagnostic": {
     "code": "invalid_input",
     "stage": "input",
     "field": "/inputs"
    }
   }
  }
 ]
}
