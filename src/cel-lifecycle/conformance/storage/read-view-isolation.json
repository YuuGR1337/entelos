{
 "format": "storage-port-vector/v1",
 "id": "read-view-isolation",
 "description": "Changes to a read view outside a transaction publish nothing and do not change later reads.",
 "invariants": [
  "atomic_publication",
  "stable_historical_read"
 ],
 "steps": [
  {
   "op": "transact",
   "expected": "",
   "key": "key-1",
   "payload": {
    "request": {
     "op": "example.write",
     "value": 1
    },
    "actor": "actor-a"
   },
   "apply": {
    "actions": [
     {
      "set": [
       "heads",
       "example.alpha"
      ],
      "value": 1
     }
    ],
    "result": 1
   },
   "expect": {
    "reused": false,
    "result": 1,
    "apply_calls": 1,
    "bind": "c1"
   }
  },
  {
   "op": "read",
   "actions": [
    {
     "put": "note",
     "value": {
      "note": "beta",
      "n": 2
     },
     "expect_ref": "sha256:cc5b3d23ddab1c472818a5f487704bea71f8be0558cafb6cfcba30c6eb9d2a0c"
    },
    {
     "set": [
      "heads",
      "example.alpha"
     ],
     "value": "changed"
    }
   ],
   "expect": {
    "cursor": "$c1"
   }
  },
  {
   "op": "read",
   "cursor": "$c1",
   "actions": [
    {
     "get": "sha256:cc5b3d23ddab1c472818a5f487704bea71f8be0558cafb6cfcba30c6eb9d2a0c",
     "kind": "note",
     "expect": {
      "error": "artifact_unavailable"
     }
    }
   ],
   "expect": {
    "cursor": "$c1",
    "state_includes": {
     "heads": {
      "example.alpha": 1
     }
    }
   }
  },
  {
   "op": "history",
   "cursor": "$c1",
   "expect": {
    "cursors": [
     "$c1"
    ]
   }
  }
 ]
}
