{
 "format": "storage-port-vector/v1",
 "id": "lost-cas-during-apply",
 "description": "Another writer publishes while apply runs. The first writer loses the final compare-and-swap and publishes nothing.",
 "invariants": [
  "stale_cas_rejection",
  "atomic_publication",
  "no_partial_state_after_failure"
 ],
 "steps": [
  {
   "op": "transact",
   "expected": "",
   "key": "key-outer",
   "payload": {
    "request": {
     "op": "example.write",
     "value": 1
    },
    "actor": "actor-a"
   },
   "apply": {
    "actions": [
     {
      "put": "note",
      "value": {
       "note": "alpha",
       "n": 1
      },
      "expect_ref": "sha256:0d7cffa4c1e11c14d855216cb292eb7c9d8b4da370d663a47b123d8082830851"
     },
     {
      "set": [
       "heads",
       "example.alpha"
      ],
      "value": "outer"
     },
     {
      "transact": {
       "op": "transact",
       "expected": "",
       "key": "key-inner",
       "payload": {
        "request": {
         "op": "example.write",
         "value": 2
        },
        "actor": "actor-a"
       },
       "apply": {
        "actions": [
         {
          "put": "note",
          "value": {
           "note": "beta",
           "n": 2
          },
          "expect_ref": "sha256:cc5b3d23ddab1c472818a5f487704bea71f8be0558cafb6cfcba30c6eb9d2a0c"
         }
        ],
        "result": "inner"
       },
       "expect": {
        "reused": false,
        "result": "inner",
        "apply_calls": 1,
        "bind": "c1"
       }
      }
     }
    ],
    "result": "outer"
   },
   "expect": {
    "error": "stale_revision",
    "apply_calls": 1
   }
  },
  {
   "op": "read",
   "actions": [
    {
     "get": "sha256:0d7cffa4c1e11c14d855216cb292eb7c9d8b4da370d663a47b123d8082830851",
     "kind": "note",
     "expect": {
      "error": "artifact_unavailable"
     }
    },
    {
     "get": "sha256:cc5b3d23ddab1c472818a5f487704bea71f8be0558cafb6cfcba30c6eb9d2a0c",
     "kind": "note",
     "expect": {
      "value": {
       "note": "beta",
       "n": 2,
       "format": "entelos.record/1"
      }
     }
    }
   ],
   "expect": {
    "cursor": "$c1",
    "state_includes": {
     "heads": {},
     "requests": {
      "key-inner": {
       "payload_ref": "sha256:f07f807532cf04ead3be8711829b4d21392419da0e461798a5505efd9f113fb7",
       "result": "inner"
      }
     }
    }
   }
  },
  {
   "op": "transact",
   "expected": "$c1",
   "key": "key-outer",
   "payload": {
    "request": {
     "op": "example.write",
     "value": 1
    },
    "actor": "actor-a"
   },
   "apply": {
    "actions": [],
    "result": "outer"
   },
   "expect": {
    "reused": false,
    "result": "outer",
    "apply_calls": 1,
    "bind": "c2"
   }
  },
  {
   "op": "history",
   "cursor": "$c2",
   "expect": {
    "cursors": [
     "$c2",
     "$c1"
    ]
   }
  }
 ]
}
