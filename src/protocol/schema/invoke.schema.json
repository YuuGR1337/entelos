{
 "$defs": {
  "request_body": {
   "additionalProperties": false,
   "properties": {
    "date": {
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
     "type": "string"
    },
    "expected_bundle_ref": {
     "pattern": "^sha256:[0-9a-f]{64}$",
     "type": "string"
    },
    "expected_revision": {
     "type": "string"
    },
    "function": {
     "minLength": 1,
     "type": "string"
    },
    "inputs": {
     "type": "object"
    },
    "request_key": {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "date",
    "expected_bundle_ref",
    "expected_revision",
    "function",
    "inputs",
    "request_key"
   ],
   "type": "object"
  },
  "result": {
   "additionalProperties": false,
   "properties": {
    "cursor": {
     "minLength": 1,
     "type": "string"
    },
    "result": {
     "additionalProperties": false,
     "properties": {
      "actual": {
       "type": "object"
      },
      "receipt": {
       "type": "object"
      },
      "receipt_ref": {
       "pattern": "^sha256:[0-9a-f]{64}$",
       "type": "string"
      }
     },
     "required": [
      "receipt_ref",
      "receipt",
      "actual"
     ],
     "type": "object"
    },
    "reused": {
     "type": "boolean"
    }
   },
   "required": [
    "cursor",
    "result",
    "reused"
   ],
   "type": "object"
  }
 },
 "$id": "https://github.com/mohanraj00/entelos/blob/main/src/protocol/schema/invoke.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "invoke",
 "x-entelos-access": "write"
}
