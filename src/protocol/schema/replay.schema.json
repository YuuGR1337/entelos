{
 "$defs": {
  "request_body": {
   "additionalProperties": false,
   "properties": {
    "expected_revision": {
     "type": "string"
    },
    "inputs_json": {
     "type": "string"
    },
    "reason": {
     "minLength": 1,
     "type": "string"
    },
    "receipt_ref": {
     "pattern": "^sha256:[0-9a-f]{64}$",
     "type": "string"
    },
    "request_key": {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "expected_revision",
    "reason",
    "receipt_ref",
    "request_key"
   ],
   "type": "object"
  },
  "result": {
   "additionalProperties": false,
   "properties": {
    "cursor": {
     "minLength": 1,
     "type": "string"
    },
    "result": {
     "additionalProperties": false,
     "properties": {
      "actual": {
       "type": "object"
      },
      "receipt": {
       "properties": {
        "format": {
         "const": "entelos.record/1"
        },
        "stale": {
         "type": "boolean"
        },
        "stale_mode": {
         "enum": [
          "fail_closed",
          "continue_stale"
         ]
        },
        "stale_reason": {
         "enum": [
          "",
          "expired",
          "revoked"
         ]
        }
       },
       "required": [
        "format",
        "stale",
        "stale_mode",
        "stale_reason"
       ],
       "type": "object"
      },
      "receipt_ref": {
       "pattern": "^sha256:[0-9a-f]{64}$",
       "type": "string"
      }
     },
     "required": [
      "receipt_ref",
      "receipt",
      "actual"
     ],
     "type": "object"
    },
    "reused": {
     "type": "boolean"
    }
   },
   "required": [
    "cursor",
    "result",
    "reused"
   ],
   "type": "object"
  }
 },
 "$id": "https://github.com/mohanraj00/entelos/blob/main/src/protocol/schema/replay.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "replay",
 "x-entelos-access": "write"
}
