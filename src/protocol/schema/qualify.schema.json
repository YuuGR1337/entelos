{
 "$defs": {
  "request_body": {
   "additionalProperties": false,
   "properties": {
    "expected_revision": {
     "type": "string"
    },
    "plan_ref": {
     "pattern": "^sha256:[0-9a-f]{64}$",
     "type": "string"
    },
    "request_key": {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    "snapshot_ref": {
     "pattern": "^sha256:[0-9a-f]{64}$",
     "type": "string"
    }
   },
   "required": [
    "expected_revision",
    "plan_ref",
    "request_key",
    "snapshot_ref"
   ],
   "type": "object"
  },
  "result": {
   "additionalProperties": false,
   "properties": {
    "cursor": {
     "minLength": 1,
     "type": "string"
    },
    "result": {
     "additionalProperties": false,
     "properties": {
      "report": {
       "properties": {
        "format": {
         "const": "entelos.record/1"
        }
       },
       "required": [
        "format"
       ],
       "type": "object"
      },
      "report_ref": {
       "pattern": "^sha256:[0-9a-f]{64}$",
       "type": "string"
      }
     },
     "required": [
      "report_ref",
      "report"
     ],
     "type": "object"
    },
    "reused": {
     "type": "boolean"
    }
   },
   "required": [
    "cursor",
    "result",
    "reused"
   ],
   "type": "object"
  }
 },
 "$id": "https://github.com/mohanraj00/entelos/blob/main/src/protocol/schema/qualify.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "qualify",
 "x-entelos-access": "write"
}
