{
 "$defs": {
  "request_body": {
   "additionalProperties": false,
   "properties": {
    "checkpoint": {
     "minLength": 1,
     "type": "string"
    },
    "correction_snapshot": {
     "type": "string"
    },
    "expected_revision": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "request_key": {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    "status": {
     "enum": [
      "working",
      "complete"
     ],
     "type": "string"
    },
    "task_id": {
     "minLength": 1,
     "type": "string"
    },
    "token": {
     "type": "string"
    }
   },
   "required": [
    "checkpoint",
    "expected_revision",
    "note",
    "request_key",
    "status",
    "task_id",
    "token"
   ],
   "type": "object"
  },
  "result": {
   "additionalProperties": false,
   "properties": {
    "cursor": {
     "minLength": 1,
     "type": "string"
    },
    "result": {
     "additionalProperties": false,
     "properties": {
      "checkpoint": {
       "minLength": 1,
       "type": "string"
      },
      "correction_snapshot": {
       "type": "string"
      },
      "function": {
       "minLength": 1,
       "type": "string"
      },
      "note": {
       "type": "string"
      },
      "observation_ref": {
       "pattern": "^sha256:[0-9a-f]{64}$",
       "type": "string"
      },
      "owner": {
       "type": "string"
      },
      "scope": {
       "minLength": 1,
       "type": "string"
      },
      "status": {
       "enum": [
        "open",
        "working",
        "complete"
       ],
       "type": "string"
      },
      "task_id": {
       "minLength": 1,
       "type": "string"
      },
      "token": {
       "type": "string"
      }
     },
     "required": [
      "observation_ref",
      "function",
      "scope",
      "status",
      "checkpoint",
      "owner",
      "token",
      "note",
      "task_id"
     ],
     "type": "object"
    },
    "reused": {
     "type": "boolean"
    }
   },
   "required": [
    "cursor",
    "result",
    "reused"
   ],
   "type": "object"
  }
 },
 "$id": "https://github.com/mohanraj00/entelos/blob/main/src/protocol/schema/checkpoint.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "checkpoint",
 "x-entelos-access": "write"
}
