{
 "$defs": {
  "request_body": {
   "additionalProperties": false,
   "properties": {
    "base_snapshot": {
     "type": "string"
    },
    "bundle": {
     "additionalProperties": false,
     "properties": {
      "environment": {
       "type": "string"
      },
      "fixed": {
       "type": "string"
      },
      "manifest": {
       "type": "string"
      },
      "source": {
       "type": "string"
      }
     },
     "required": [
      "manifest",
      "environment",
      "source",
      "fixed"
     ],
     "type": "object"
    },
    "expected_revision": {
     "type": "string"
    },
    "from": {
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
     "type": "string"
    },
    "function": {
     "minLength": 1,
     "type": "string"
    },
    "reason": {
     "minLength": 1,
     "type": "string"
    },
    "request_key": {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    "source_ref": {
     "pattern": "^sha256:[0-9a-f]{64}$",
     "type": "string"
    },
    "until": {
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
     "type": "string"
    }
   },
   "required": [
    "base_snapshot",
    "bundle",
    "expected_revision",
    "from",
    "function",
    "reason",
    "request_key",
    "source_ref",
    "until"
   ],
   "type": "object"
  },
  "result": {
   "additionalProperties": false,
   "properties": {
    "cursor": {
     "minLength": 1,
     "type": "string"
    },
    "result": {
     "additionalProperties": false,
     "properties": {
      "bundle_ref": {
       "pattern": "^sha256:[0-9a-f]{64}$",
       "type": "string"
      },
      "snapshot_ref": {
       "pattern": "^sha256:[0-9a-f]{64}$",
       "type": "string"
      }
     },
     "required": [
      "snapshot_ref",
      "bundle_ref"
     ],
     "type": "object"
    },
    "reused": {
     "type": "boolean"
    }
   },
   "required": [
    "cursor",
    "result",
    "reused"
   ],
   "type": "object"
  }
 },
 "$id": "https://github.com/mohanraj00/entelos/blob/main/src/protocol/schema/propose.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "propose",
 "x-entelos-access": "write"
}
