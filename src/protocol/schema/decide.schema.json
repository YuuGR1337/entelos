{
 "$defs": {
  "request_body": {
   "additionalProperties": false,
   "properties": {
    "expected_revision": {
     "type": "string"
    },
    "reason": {
     "minLength": 1,
     "type": "string"
    },
    "report_ref": {
     "pattern": "^sha256:[0-9a-f]{64}$",
     "type": "string"
    },
    "request_key": {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "expected_revision",
    "reason",
    "report_ref",
    "request_key"
   ],
   "type": "object"
  },
  "result": {
   "additionalProperties": false,
   "properties": {
    "cursor": {
     "minLength": 1,
     "type": "string"
    },
    "result": {
     "additionalProperties": false,
     "properties": {
      "decision_ref": {
       "pattern": "^sha256:[0-9a-f]{64}$",
       "type": "string"
      }
     },
     "required": [
      "decision_ref"
     ],
     "type": "object"
    },
    "reused": {
     "type": "boolean"
    }
   },
   "required": [
    "cursor",
    "result",
    "reused"
   ],
   "type": "object"
  }
 },
 "$id": "https://github.com/mohanraj00/entelos/blob/main/src/protocol/schema/decide.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "decide",
 "x-entelos-access": "write"
}
