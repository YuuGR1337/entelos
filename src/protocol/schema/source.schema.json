{
 "$defs": {
  "request_body": {
   "additionalProperties": false,
   "properties": {
    "expected_revision": {
     "type": "string"
    },
    "from": {
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
     "type": "string"
    },
    "function": {
     "minLength": 1,
     "type": "string"
    },
    "reason": {
     "minLength": 1,
     "type": "string"
    },
    "request_key": {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    "supersedes": {
     "items": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
     },
     "type": "array"
    },
    "text": {
     "minLength": 1,
     "type": "string"
    },
    "until": {
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
     "type": "string"
    }
   },
   "required": [
    "expected_revision",
    "from",
    "function",
    "reason",
    "request_key",
    "text",
    "until"
   ],
   "type": "object"
  },
  "result": {
   "additionalProperties": false,
   "properties": {
    "cursor": {
     "minLength": 1,
     "type": "string"
    },
    "result": {
     "additionalProperties": false,
     "properties": {
      "source_ref": {
       "pattern": "^sha256:[0-9a-f]{64}$",
       "type": "string"
      }
     },
     "required": [
      "source_ref"
     ],
     "type": "object"
    },
    "reused": {
     "type": "boolean"
    }
   },
   "required": [
    "cursor",
    "result",
    "reused"
   ],
   "type": "object"
  }
 },
 "$id": "https://github.com/mohanraj00/entelos/blob/main/src/protocol/schema/source.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "source",
 "x-entelos-access": "write"
}
