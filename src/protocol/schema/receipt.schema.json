{
 "$defs": {
  "request_body": {
   "additionalProperties": false,
   "properties": {
    "receipt_ref": {
     "pattern": "^sha256:[0-9a-f]{64}$",
     "type": "string"
    }
   },
   "required": [
    "receipt_ref"
   ],
   "type": "object"
  },
  "result": {
   "properties": {
    "executor_id": {
     "minLength": 1,
     "type": "string"
    },
    "format": {
     "const": "entelos.record/1"
    },
    "log_cursor": {
     "maximum": 9007199254740991,
     "minimum": 1,
     "type": "integer"
    },
    "stale": {
     "type": "boolean"
    },
    "stale_mode": {
     "enum": [
      "fail_closed",
      "continue_stale"
     ]
    },
    "stale_reason": {
     "enum": [
      "",
      "expired",
      "revoked"
     ]
    }
   },
   "required": [
    "format",
    "stale",
    "stale_mode",
    "stale_reason",
    "executor_id",
    "log_cursor"
   ],
   "type": "object"
  }
 },
 "$id": "https://github.com/mohanraj00/entelos/blob/main/src/protocol/schema/receipt.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "receipt",
 "x-entelos-access": "read"
}
